# 品牌-营销-传播

filters:
  and:
    - note["base"] == link("品牌-营销-传播.base")
properties:
  file.name:
    displayName: Name
  分类:
    displayName: 分类
  封面:
    displayName: 封面
  作者:
    displayName: 作者
  简介:
    displayName: 简介
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 分类
      - 封面
      - 作者
      - 简介

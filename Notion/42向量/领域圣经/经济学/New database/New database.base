# New database

filters:
  and:
    - note["base"] == link("New database.base")
properties:
  file.name:
    displayName: 名称
  封面:
    displayName: 封面
  简介:
    displayName: 简介
  分类:
    displayName: 分类
  作者:
    displayName: 作者
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 封面
      - 简介
      - 分类
      - 作者

# 思维-逻辑-表达

filters:
  and:
    - note["base"] == link("思维-逻辑-表达.base")
properties:
  file.name:
    displayName: Name
  作者:
    displayName: 作者
  简介:
    displayName: 简介
  分类:
    displayName: 分类
  封面:
    displayName: 封面
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 作者
      - 简介
      - 分类
      - 封面

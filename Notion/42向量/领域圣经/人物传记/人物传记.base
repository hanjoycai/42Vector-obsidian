# 人物传记

filters:
  and:
    - note["base"] == link("人物传记.base")
properties:
  file.name:
    displayName: Name
  封面:
    displayName: 封面
  作者:
    displayName: 作者
  简介:
    displayName: 简介
  公司:
    displayName: 公司
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 封面
      - 作者
      - 简介
      - 公司

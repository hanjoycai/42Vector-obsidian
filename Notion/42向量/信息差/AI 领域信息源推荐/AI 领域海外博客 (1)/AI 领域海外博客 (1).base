# AI 领域海外博客 (1)

filters:
  and:
    - note["base"] == link("AI 领域海外博客 (1).base")
properties:
  file.name:
    displayName: 名称
  网址链接:
    displayName: 网址链接
  标签:
    displayName: 标签
  简介:
    displayName: 简介
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 网址链接
      - 标签
      - 简介

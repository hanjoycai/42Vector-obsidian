# AI 领域海外博客 (2)

filters:
  and:
    - note["base"] == link("AI 领域海外博客 (2).base")
properties:
  file.name:
    displayName: X 账号名称
  职业简介:
    displayName: 职业简介
  类型:
    displayName: 类型
  X链接:
    displayName: X链接
  一键关注:
    displayName: 一键关注
  简介:
    displayName: 简介
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 职业简介
      - 类型
      - X链接
      - 一键关注
      - 简介
